# R8 / ProGuard Keep Rules for Flammenwerfer

# Keep JavaScript Interface methods in WebView
-keepclassmembers class * {
    @android.webkit.JavascriptInterface <methods>;
}

# Keep XIntent JS Bridge class
-keep class org.xintent.flammenwerfer.XIntentJSBridge {
    public *;
}

# Keep XIntent JSON data models and client methods
-keepclassmembers class org.xintent.flammenwerfer.XIntentClient$* {
    *;
}
